#!/usr/bin/env bash

PORT=8080
ADDRESS=0.0.0.0

fatal() {
    echo  '[fatal]' "$@" >&2
    exit 1
}

# this func is inspired by the repo "bash bible"
urldecode() {
    # usage: urldecode string
    : ${1//+/ }
    printf '%b\n' "${_//%/\\x}"
}

normalize-path () {
    local path=/$1

    local parts
    IFS='/' read -r -a parts <<< "$path"

    local -a part
    local -a out=()
    for part in "${parts[@]}"; do
        case "$part" in 
                '') ;; # ignore emtpy directories (multiple /)
                '.') ;; # ignore the current directory
                '..') unset 'out[-1]' 2>/dev/null;;
                *) out+=("$part");;
        esac
    done

    local s
    s=$(IFS=/; echo "${out[*]}")
    echo "/$s"
}

parse-request () {
    # where we store the meta data: method, version, path, ...
    declare -gA REQ_INFO=()
    declare -gA REQ_HEADERS=()

    local state='status'
    local line
    while read -r line; do 
        line=${line%$'\r'}

        case "$state" in
                'status')
                        # parse the status line
                        local method path version
                        read -r method path version <<< "$line"
                        REQ_INFO[method]=$method
                        REQ_INFO[path]=$path 
                        REQ_INFO[version]=$version
                        state='headers'
                        ;;
                'headers')
                        if [[ -z $line ]]; then 
                            break
                        fi
                        # parse the headers
                        local key value
                        IFS=: read -r key value <<< "$line"
                        # make the key lower case, headers are case insensetive
                        key=${key,,}
                        value=${value# *}
                        REQ_HEADERS[$key]=$value
                        ;;
                'body')
                        # pase the body
                        fatal 'body parsing not supported'
                        ;;
        esac
    done
}

process-request(){
    local fd=$1
       parse-request <&$"$fd"

    # validate the request
    [[ ${REQ_INFO[version]} == 'HTTP/1.1' ]] || fatal 'unsupported http version'
    [[ ${REQ_INFO[method]} == 'GET' ]] || fatal 'unsupported http method'
    [[ ${REQ_INFO[path]} == /* ]] || fatal 'path must be absolute'

    echo "${REQ_INFO[method]} ${REQ_INFO[path]}"

    # local line
    # while read -r -u "$fd" line; do 
    #     line=${line%$'\r'}
    #     echo "got data: $line"

    #     # we are done processing headers
    #     # -z means if it's empty a short way!
    #     if [[ -z $line ]]; then 
    #         break
    #     fi
    # done

    # if we are here, we should reply to the caller so we need to write to the file scripter
    # "/foo%20bar.txt?query=sth"
    local path="${REQ_INFO[path]}"

    # "././foo%20bar.txt?query=sth"
    path=${path:1}

    # "././foo%20bar.txt"
    local query
    IFS='?' read -r path query <<< "$path"

    # "././foo bar.txt"
    path=$(urldecode "$path")

    # "/foo bar.txt"
    path=$(normalize-path "$path")

    # "foo bar.txt"
   path=${path:1}

    echo "trying to find file '$path'"

    if [[ -f $path ]]; then
        printf 'HTTP/1.1 200 ok\r\n' >&"$fd"
        printf 'Content-Type: text/plain\r\n' >&"$fd"
        printf '\r\n' >&"$fd"
        cat "$path" >&"$fd"
    else
        printf 'HTTP/1.1 404 Not Found\r\n' >&"$fd" 
        printf '\r\n' >&"$fd"
    fi
    
    exec {fd}>&-
}

main (){
    enable accept || fatal 'failed to load accept'

    echo "Listening on http://$ADDRESS:$PORT"
    local fd ip

    while true; do
        accept -b "$ADDRESS" -v fd -r ip "$PORT" || fatal 'failed to read socket'
        process-request "$fd"
    done
}

main "$@"